      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Signup - Success (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Unified success response shape', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.user).to.be.an('object');",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('userEmail').toLowerCase());",
                  "    pm.expect(json.data.user.passwordHash).to.be.undefined;",
                  "});",
                  "// Extract cookie token if set",
                  "const tokenCookie = pm.cookies.get('token');",
                  "if (tokenCookie) {",
                  "    pm.environment.set('authToken', tokenCookie);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
