# Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pathforge?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# AI LLM Integration (Groq preferred for high-speed inference, Gemini swappable)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000

# Rate Limiting Configuration (Optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SUBMIT_MAX=15
RATE_LIMIT_GENERAL_MAX=100
DISABLE_RATE_LIMIT=false
