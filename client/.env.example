# PathForge Client – Environment Variables
# Copy this file to .env for local development, or configure in your deployment platform (Vercel, Netlify, Cloudflare).

# Backend API base URL (no trailing slash)
# Local: http://localhost:5000 | Production: https://api.pathforge.dev
VITE_API_URL=http://localhost:5000

# Set to "true" to use client-side mock store, or "false" to connect to real backend API.
# Defaults to "false" in production builds.
VITE_USE_MOCK=false

# Feature flag: Set to "true" to enable the module checkpoint quiz stretch feature.
VITE_ENABLE_CHECKPOINT=false
