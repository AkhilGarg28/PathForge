# PathForge Client – Production Environment
# Used automatically during production builds (vite build)

# Backend API base URL (in production this points to the real backend service or domain)
VITE_API_URL=https://api.pathforge.dev

# Production build disables mock mode to connect to the real API
VITE_USE_MOCK=false

# Feature flag for stretch checkpoint quiz feature
VITE_ENABLE_CHECKPOINT=false
